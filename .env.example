DATABASE_URL=postgresql+asyncpg://redbull:redbull@localhost:5432/redbull
TEST_DATABASE_URL=postgresql+asyncpg://redbull:redbull@localhost:5433/redbull_test
# Pagamento: só Mercado Pago. As duas são obrigatórias (o app não sobe sem elas).
# Localmente, use as credenciais de teste da sua integração no painel do Mercado Pago.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
CHARGE_EXPIRES_IN=1800
# Tempo da tela/reserva local (10 minutos). O Mercado Pago exige ao menos 30 minutos.
PAYMENT_CHECKOUT_EXPIRES_IN=600
PAYMENT_EXPIRATION_CHECK_INTERVAL=5
# Logs (INFO por padrão) e documentação interativa da API (/docs; só fora de produção)
LOG_LEVEL=INFO
API_DOCS=1
# Painel de estoque (/estoque)
# Em produção (HTTPS) mantenha true; em http://localhost use false.
STOCK_SESSION_COOKIE_SECURE=true
STOCK_SESSION_TTL_HOURS=12
STOCK_LOGIN_MAX_ATTEMPTS=5
STOCK_LOGIN_LOCK_MINUTES=15
STOCK_TIMEZONE=America/Recife
